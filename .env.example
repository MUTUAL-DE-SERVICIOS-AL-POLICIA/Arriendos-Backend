# ============================================================
# CONFIGURACION DE ENTORNO - ARRIENDOS BACKEND
# ============================================================
# Copia este archivo como .env y rellena con tus valores reales:
#   cp .env.example .env

# ----------------------------------------------------------
# DJANGO
# ----------------------------------------------------------
# Clave secreta: genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True para desarrollo, False para produccion
DEBUG=True

# Hosts permitidos separados por coma
ALLOWED_HOSTS=127.0.0.1,localhost

# URLs del frontend separadas por coma
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------
# BASE DE DATOS
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_arriendos
DB_USER=postgres
DB_PASSWORD=

# ----------------------------------------------------------
# LDAP (opcional)
# ----------------------------------------------------------
LDAP_STATUS=False
LDAP_SERVER=
LDAP_USER=
LDAP_PASSWORD=
LDAP_USER_DN=
LDAP_BASE=
