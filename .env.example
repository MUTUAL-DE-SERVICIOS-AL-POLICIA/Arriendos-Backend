# ============================================================
# CONFIGURACION DOCKER COMPOSE - ARRIENDOS
# ============================================================
# Variables para los contenedores
# Ajusta estos valores según tu entorno

# --- PUERTOS ---
BACKEND_PORT=9005
FRONTEND_PORT=9006

# --- BASE DE DATOS ---
# host.docker.internal = maquina host (Docker Desktop)
# En Linux puede necesitar la IP real del host
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=bd_arriendos_2026-08
DB_USER=postgres
DB_PASSWORD=<TU_PASSWORD>
