# ============================================================
# CONFIGURACION POR ENTORNO
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Ajusta los valores para tu entorno
#   3. NUNCA subas .env a git (esta en .gitignore)
#
# ENTORNOS:
#   LOCAL:      DB en tu maquina, LDAP desactivado, DEBUG=True
#   PRUEBAS:    DB remota (<IP_BD>:5438), LDAP activo
#   PRODUCCION: DB dedicada (<IP_PROD>), LDAP activo, DEBUG=False
# ============================================================

# --- BASE DE DATOS ---
# Pruebas:  <IP_BD> / 5438 / <NOMBRE_BD>
# Produccion: <IP_PROD> / 5432 / bd_arriendos
DB_HOST=<TU_DB_HOST>
DB_PORT=<TU_DB_PORT>
DB_NAME=<TU_DB_NAME>
DB_USER=<TU_DB_USER>
DB_PASSWORD=<TU_DB_PASSWORD>

# --- DJANGO ---
# SECRET_KEY: Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<TU_SECRET_KEY>
DEBUG=True
ALLOWED_HOSTS=<TU_HOSTNAME_O_IP>
ENVIRONMENT=local

# --- CORS (URLs del frontend separadas por coma) ---
# Ejemplo pruebas: http://<IP_SERVIDOR>:83,http://<IP_SERVIDOR>:4300
CORS_ORIGINS=http://localhost:9006

# --- LDAP ---
LDAP_STATUS=False
LDAP_SERVER=<TU_LDAP_SERVER>
LDAP_USER=<TU_LDAP_USER>
LDAP_PASSWORD=<TU_LDAP_PASSWORD>

# --- GUNICORN (solo produccion) ---
# Regla: workers = 2 * CPU_CORES + 1
# 1 CPU = 2 workers, 2 CPU = 4-5 workers, 4 CPU = 8-9 workers
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
